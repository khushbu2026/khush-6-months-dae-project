[{"updatedAt":"2026-10-05T18:43:14.000Z","createdAt":"2026-09-16T15:22:35.539Z","id":"BOZEtaPPVTNycJTY","name":"Wazuh Auto-Block Security Response","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"content":"## Wazuh Auto-Block: Detect -> Trigger -> Decide -> Block -> Log -> Notify\n\nEvery 5 minutes this workflow queries Wazuh for new Critical/High alerts, extracts the attacker source IP, skips IPs already blocked (checked against the Data Table), blocks the IP via Wazuh Active Response, then logs the action to both a Data Table and Grafana, and emails the SOC analyst.\n\n### Setup required before activating\n- Create a Data Table named \"blocked_ip_log\" with columns: sourceIp, ruleId, ruleDescription, level, agentId, agentName, blockedAt, eventId\n- Add credentials: \"Wazuh Indexer\" (Basic Auth, read-only), \"Wazuh Manager API\" (Basic Auth), \"Grafana API\" (Header Auth), \"SMTP\"\n- Replace placeholder URLs/emails in \"Configure auto-block settings\"\n- Test manually before turning on the schedule","height":460,"width":640,"color":4},"id":"48ad4bb1-99d3-44e5-9b3c-30ffd2099e97","name":"Overview","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,-528]},{"parameters":{"rule":{"interval":[{"field":"minutes"}]}},"id":"354008c2-472a-4f35-b56c-398fa11b4b8f","name":"Check for suspicious activity every 5 minutes","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[0,0]},{"parameters":{"assignments":{"assignments":[{"id":"org-name","name":"organizationName","type":"string","value":"Khushbu SOC Lab"},{"id":"indexer-url","name":"wazuhIndexerUrl","type":"string","value":"https://host.docker.internal:9200"},{"id":"api-url","name":"wazuhApiUrl","type":"string","value":"https://host.docker.internal:55000"},{"id":"critical-min","name":"criticalLevelMin","type":"number","value":12},{"id":"high-min","name":"highLevelMin","type":"number","value":10},{"id":"lookback-min","name":"lookbackMinutes","type":"number","value":5},{"id":"soc-email","name":"socAnalystEmail","type":"string","value":"kjalan1984@gmail.com"},{"id":"sender-name","name":"senderName","type":"string","value":"Wazuh Auto-Block Bot"},{"id":"sender-email","name":"senderEmail","type":"string","value":"kjalan1984@gmail.com"},{"id":"grafana-url","name":"grafanaUrl","type":"string","value":"http://host.docker.internal:3000"}]},"options":{}},"id":"f5a93978-42c4-4f02-aa1f-d71277daff62","name":"Configure auto-block settings","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[240,0]},{"parameters":{"method":"POST","url":"={{ $(\"Configure auto-block settings\").first().json.wazuhIndexerUrl.replace(/\\/$/, \"\") + \"/wazuh-alerts*/_search\" }}","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ { size: 50, query: { bool: { filter: [ { range: { timestamp: { gte: $now.minus({ minutes: $(\"Configure auto-block settings\").first().json.lookbackMinutes }).toISO() } } }, { range: { \"rule.level\": { gte: $(\"Configure auto-block settings\").first().json.highLevelMin } } } ] } }, sort: [ { timestamp: { order: \"desc\" } } ] } }}","options":{"allowUnauthorizedCerts":true,"response":{"response":{"responseFormat":"json"}},"timeout":30000}},"id":"b56120a2-7e94-487f-8926-7878a286f1f3","name":"Query Wazuh for high-severity alerts","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[480,0],"credentials":{"httpBasicAuth":{"id":"D4UzNIPN8uGjVhcE","name":"Wazuh Indexer Basic Auth"}}},{"parameters":{"jsCode":"const response = $input.first().json;\nconst hits = response.hits?.hits || [];\nconst seen = new Map();\n\nfor (const hit of hits) {\n  const source = hit._source || {};\n  const ip = source.data?.srcip || source.data?.src_ip || source.srcip\n    || source.data?.win?.eventdata?.ipAddress || '';\n  if (!ip) continue;\n  if (!seen.has(ip)) {\n    seen.set(ip, {\n      sourceIp: ip,\n      ruleId: String(source.rule?.id || ''),\n      ruleDescription: source.rule?.description || '',\n      level: Number(source.rule?.level || 0),\n      agentId: source.agent?.id || '000',\n      agentName: source.agent?.name || 'unassigned',\n      timestamp: source.timestamp || '',\n      eventId: String(hit._id || ''),\n    });\n  }\n}\n\nreturn Array.from(seen.values()).map((item) => ({ json: item }));"},"id":"4a64cc52-561c-4201-ab11-fabb259bfd6a","name":"Extract suspicious source IPs","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,0]},{"parameters":{"operation":"rowNotExists","dataTableId":{"__rl":true,"mode":"name","value":"blocked_ip_log"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"sourceIp","keyValue":"={{ $json.sourceIp }}"}]}},"id":"c8b18465-70b2-4452-9c92-f682128adcce","name":"Skip IPs already blocked","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[960,0]},{"parameters":{"method":"POST","url":"={{ $(\"Configure auto-block settings\").first().json.wazuhApiUrl.replace(/\\/$/, \"\") + \"/security/user/authenticate\" }}","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth","options":{"allowUnauthorizedCerts":true,"response":{"response":{"responseFormat":"json"}},"timeout":15000}},"id":"d6c2f248-fbcc-4c55-b97d-7b856076f781","name":"Authenticate to Wazuh Manager API","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1200,0],"executeOnce":true,"credentials":{"httpBasicAuth":{"id":"wvCwJvMyMrJxbvua","name":"Wazuh Manager API Basic Auth"}}},{"parameters":{"jsCode":"const authJson = $('Authenticate to Wazuh Manager API').first().json;\nconst token = authJson.data?.token || authJson.token;\nconst items = $('Skip IPs already blocked').all();\nreturn items.map((item) => ({ json: { ...item.json, wazuhToken: token } }));"},"id":"df57a6a8-54b4-445a-abcf-28f31e3be886","name":"Attach auth token to each IP","type":"n8n-nodes-base.code","typeVersion":2,"position":[1440,0]},{"parameters":{"method":"PUT","url":"={{ $(\"Configure auto-block settings\").first().json.wazuhApiUrl.replace(/\\/$/, \"\") + \"/active-response?agents_list=\" + $json.agentId }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ \"Bearer \" + $json.wazuhToken }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { command: \"win_route-null0\", arguments: [ $json.sourceIp ], alert: { data: { srcip: $json.sourceIp } } } }}","options":{"allowUnauthorizedCerts":true,"response":{"response":{"responseFormat":"json"}},"timeout":15000}},"id":"ce4c10c3-7138-4f9d-b8da-6c261d4b1424","name":"Block IP via Wazuh Active Response","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1680,0]},{"parameters":{"mode":"runOnceForEachItem","jsCode":"const original = $('Attach auth token to each IP').item.json;\nreturn { json: { ...original, blockResponse: $json } };"},"id":"4e3a9bb0-5300-4f83-90a3-589000458ff2","name":"Merge block result with alert data","type":"n8n-nodes-base.code","typeVersion":2,"position":[1808,0]},{"parameters":{"dataTableId":{"__rl":true,"mode":"name","value":"blocked_ip_log"},"columns":{"mappingMode":"defineBelow","matchingColumns":[],"value":{"sourceIp":"={{ $json.sourceIp }}","ruleId":"={{ $json.ruleId }}","ruleDescription":"={{ $json.ruleDescription }}","level":"={{ $json.level }}","agentId":"={{ $json.agentId }}","agentName":"={{ $json.agentName }}","blockedAt":"={{ $now.toISO() }}","eventId":"={{ $json.eventId }}"},"schema":[{"id":"sourceIp","type":"string","display":true,"displayName":"sourceIp"},{"id":"ruleId","type":"string","display":true,"displayName":"ruleId"},{"id":"ruleDescription","type":"string","display":true,"displayName":"ruleDescription"},{"id":"level","type":"number","display":true,"displayName":"level"},{"id":"agentId","type":"string","display":true,"displayName":"agentId"},{"id":"agentName","type":"string","display":true,"displayName":"agentName"},{"id":"blockedAt","type":"dateTime","display":true,"displayName":"blockedAt"},{"id":"eventId","type":"string","display":true,"displayName":"eventId"}]},"options":{}},"id":"2e937558-e6ef-4924-be7e-fb9bf57eaa42","name":"Log block to Data Table","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[2016,-160]},{"parameters":{"method":"POST","url":"={{ $(\"Configure auto-block settings\").first().json.grafanaUrl.replace(/\\/$/, \"\") + \"/api/annotations\" }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ { time: Date.now(), tags: [\"wazuh\",\"auto-block\", $json.agentName], text: \"Blocked \" + $json.sourceIp + \" on agent \" + $json.agentName + \" (rule \" + $json.ruleId + \", level \" + $json.level + \")\" } }}","options":{"response":{"response":{"responseFormat":"json"}},"timeout":15000}},"id":"3b152b11-fc09-4218-9c91-97b00c9ce3c1","name":"Log block to Grafana","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[2032,0],"credentials":{"httpHeaderAuth":{"id":"8oDlALHs3kYv3cVp","name":"Grafana API Token"}}},{"parameters":{"fromEmail":"={{ $(\"Configure auto-block settings\").first().json.senderName + \" <\" + $(\"Configure auto-block settings\").first().json.senderEmail + \">\" }}","toEmail":"={{ $(\"Configure auto-block settings\").first().json.socAnalystEmail }}","subject":"={{ \"[Auto-Blocked] \" + $json.sourceIp + \" on \" + $json.agentName }}","html":"={{ \"<h2>IP automatically blocked</h2><p><b>IP:</b> \" + $json.sourceIp + \"</p><p><b>Agent:</b> \" + $json.agentName + \" (\" + $json.agentId + \")</p><p><b>Rule:</b> \" + $json.ruleId + \" - \" + $json.ruleDescription + \"</p><p><b>Level:</b> \" + $json.level + \"</p><p><b>Event time:</b> \" + $json.timestamp + \"</p><p>This IP was automatically blocked via Wazuh Active Response. Please validate this action.</p>\" }}","options":{"appendAttribution":false}},"id":"e9a24ada-16ef-45e5-b9ed-43aeb32957a6","name":"Notify SOC analyst","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[2032,192],"webhookId":"680d8365-395a-4b37-aef8-6d9dd236ba4d","credentials":{"smtp":{"id":"Gf5JvENUxhRF6IgQ","name":"Gmail SMTP (SOC alerts)"}}},{"parameters":{},"id":"test_manual_trigger","name":"TEST - Manual Trigger","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,704]},{"parameters":{"assignments":{"assignments":[{"id":"t1","name":"sourceIp","type":"string","value":"203.0.113.1"},{"id":"t2","name":"ruleId","type":"string","value":"100100"},{"id":"t3","name":"ruleDescription","type":"string","value":"TEST - simulated brute force for pipeline validation (safe, not a real alert)"},{"id":"t4","name":"level","type":"number","value":12},{"id":"t5","name":"agentId","type":"string","value":"999"},{"id":"t6","name":"agentName","type":"string","value":"TEST-FAKE-AGENT (does not exist)"},{"id":"t7","name":"timestamp","type":"string","value":"={{ $now.toISO() }}"},{"id":"t8","name":"eventId","type":"string","value":"={{ 'test-manual-' + $now.toMillis() }}"}]},"options":{}},"id":"test_fake_alert","name":"TEST - Fake Alert (safe IP + fake agent)","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[240,704]}],"connections":{"Check for suspicious activity every 5 minutes":{"main":[[{"node":"Configure auto-block settings","type":"main","index":0}]]},"Configure auto-block settings":{"main":[[{"node":"Query Wazuh for high-severity alerts","type":"main","index":0}]]},"Query Wazuh for high-severity alerts":{"main":[[{"node":"Extract suspicious source IPs","type":"main","index":0}]]},"Extract suspicious source IPs":{"main":[[{"node":"Skip IPs already blocked","type":"main","index":0}]]},"Skip IPs already blocked":{"main":[[{"node":"Authenticate to Wazuh Manager API","type":"main","index":0}]]},"Authenticate to Wazuh Manager API":{"main":[[{"node":"Attach auth token to each IP","type":"main","index":0}]]},"Attach auth token to each IP":{"main":[[{"node":"Block IP via Wazuh Active Response","type":"main","index":0}]]},"Block IP via Wazuh Active Response":{"main":[[{"node":"Merge block result with alert data","type":"main","index":0}]]},"Merge block result with alert data":{"main":[[{"node":"Log block to Data Table","type":"main","index":0},{"node":"Log block to Grafana","type":"main","index":0},{"node":"Notify SOC analyst","type":"main","index":0}]]},"TEST - Manual Trigger":{"main":[[{"node":"TEST - Fake Alert (safe IP + fake agent)","type":"main","index":0}]]},"TEST - Fake Alert (safe IP + fake agent)":{"main":[[{"node":"Skip IPs already blocked","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":true,"binaryMode":"separate"},"staticData":{"node:Check for suspicious activity every 5 minutes":{"recurrenceRules":[]}},"meta":{"aiBuilderAssisted":true},"pinData":{},"versionId":"b8657df2-a6e5-4003-bd3a-2a5638cc389d","activeVersionId":"b8657df2-a6e5-4003-bd3a-2a5638cc389d","versionCounter":14,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-09-16T15:22:35.545Z","createdAt":"2026-09-16T15:22:35.545Z","role":"workflow:owner","workflowId":"BOZEtaPPVTNycJTY","projectId":"TjarYfVu5FqpU9Se","project":{"updatedAt":"2026-05-07T16:21:47.795Z","createdAt":"2026-05-07T16:19:41.379Z","id":"TjarYfVu5FqpU9Se","name":"Admin soc <admin@soc.local>","type":"personal","icon":null,"description":null,"creatorId":"4bae0065-d720-4941-a5f1-9ae0835f67f9"}}],"versionMetadata":{"name":null,"description":null}}]